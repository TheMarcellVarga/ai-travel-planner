NEXT_PUBLIC_APP_URL=http://localhost:3000

# Guarded route composition rollout flags
ROUTE_AGENT_MODE=deterministic
ROUTE_DESTINATION_MODE=supabase
ROUTE_PRICE_MODE=fixture
ROUTE_MEDIA_MODE=hybrid
NEXT_PUBLIC_MAP_RENDERER=svg
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only OAuth providers configured in the Supabase project (google, github).
AUTH_OAUTH_PROVIDERS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Privacy-safe operational controls (recommended in production)
RATE_LIMIT_HASH_SECRET=
OBSERVABILITY_HASH_SECRET=

# Enable managed-account billing controls only after Stripe test-mode QA.
# Demo accounts always keep billing disabled.
BILLING_UI_ENABLED=false

# Skyscanner partner access; never expose this key to the browser.
# Keep disabled until partner access and production quota controls are in place.
SKYSCANNER_ENABLED=false
SKYSCANNER_API_KEY=
